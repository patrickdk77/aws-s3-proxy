#!/usr/bin/env bash
set -eu

echo "🔵 push"
source hooks/.config

# repo name plus tag
BUILD_IMAGE="${IMAGE_NAME//index.docker.io\/}"

# only repo name
BUILD_REPO="${DOCKER_REPO//index.docker.io\/}"

# 1. add tags

tagparts=(${DOCKER_TAG//./ });
for tag in "${tagparts[@]}"; do
  if [ ! -v BUILD_NAME ]; then
    BUILD_NAME="${BUILD_REPO}:${tag}"
  else
    BUILD_NAME="${BUILD_NAME}.${tag}"
  fi

  echo "✅ Tagging as ${BUILD_NAME}"
  echo "⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯"
  docker tag ${BUILD_IMAGE} ${BUILD_NAME}
  echo
done

if [[ ${!DOCKER_EXTRATAGS-x} == x ]]; then
  for tag in ${DOCKER_EXTRATAGS}; do
    BUILD_NAME="${BUILD_REPO}:${tag}"

    echo "✅ Tagging as ${BUILD_NAME}"
    echo "⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯"
    docker tag ${BUILD_IMAGE} ${BUILD_NAME}
    echo
  done
fi

docker image ls

# 2. push

echo "✅ Pushing ${BUILD_IMAGE}"
echo "⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯"
echo
echo docker push ${BUILD_IMAGE} --all-tags

echo
echo "😊"
